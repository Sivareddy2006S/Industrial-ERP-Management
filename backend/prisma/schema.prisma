// This is the Prisma schema for the Industrial ERP Management System.
// It defines all entities, relationships, constraints, and enums.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ──────────────────────────────────────────────────────

enum Role {
  ADMIN
  SALES
}

enum EnquiryStatus {
  NEW
  QUOTED
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum SalesOrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  CANCELLED
}

// ─── Users ──────────────────────────────────────────────────────

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  name      String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enquiries   Enquiry[]
  quotations  Quotation[]
  salesOrders SalesOrder[]
  dispatches  Dispatch[]

  @@map("users")
}

// ─── Customers ──────────────────────────────────────────────────

model Customer {
  id            Int      @id @default(autoincrement())
  companyName   String
  contactPerson String
  mobile        String
  email         String   @unique
  city          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enquiries   Enquiry[]
  quotations  Quotation[]
  salesOrders SalesOrder[]

  @@map("customers")
}

// ─── Products ───────────────────────────────────────────────────

model Product {
  id          Int      @id @default(autoincrement())
  productCode String   @unique
  productName String
  category    String
  unit        String
  basePrice   Decimal  @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventory      Inventory?
  enquiryItems   EnquiryItem[]
  quotationItems QuotationItem[]
  salesOrderItems SalesOrderItem[]
  dispatchItems  DispatchItem[]

  @@map("products")
}

// ─── Inventory ──────────────────────────────────────────────────

model Inventory {
  id               Int      @id @default(autoincrement())
  productId        Int      @unique
  physicalQuantity Int      @default(0)
  reservedQuantity Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])

  @@map("inventory")
}

// ─── Enquiries ──────────────────────────────────────────────────

model Enquiry {
  id            Int           @id @default(autoincrement())
  enquiryNumber String        @unique
  customerId    Int
  enquiryDate   DateTime      @default(now())
  requiredDate  DateTime
  notes         String?
  status        EnquiryStatus @default(NEW)
  createdById   Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  customer  Customer      @relation(fields: [customerId], references: [id])
  createdBy User          @relation(fields: [createdById], references: [id])
  items     EnquiryItem[]
  quotations Quotation[]

  @@map("enquiries")
}

model EnquiryItem {
  id        Int @id @default(autoincrement())
  enquiryId Int
  productId Int
  quantity  Int

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("enquiry_items")
}

// ─── Quotations ─────────────────────────────────────────────────

model Quotation {
  id              Int             @id @default(autoincrement())
  quotationNumber String          @unique
  enquiryId       Int
  customerId      Int
  validUntil      DateTime
  status          QuotationStatus @default(DRAFT)
  subtotal        Decimal         @db.Decimal(12, 2) @default(0)
  discountAmount  Decimal         @db.Decimal(12, 2) @default(0)
  gstAmount       Decimal         @db.Decimal(12, 2) @default(0)
  grandTotal      Decimal         @db.Decimal(12, 2) @default(0)
  createdById     Int
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  enquiry    Enquiry         @relation(fields: [enquiryId], references: [id])
  customer   Customer        @relation(fields: [customerId], references: [id])
  createdBy  User            @relation(fields: [createdById], references: [id])
  items      QuotationItem[]
  salesOrder SalesOrder?

  @@map("quotations")
}

model QuotationItem {
  id              Int     @id @default(autoincrement())
  quotationId     Int
  productId       Int
  quantity        Int
  unitPrice       Decimal @db.Decimal(12, 2)
  discountPercent Decimal @db.Decimal(5, 2) @default(0)
  gstPercent      Decimal @db.Decimal(5, 2) @default(18)
  lineAmount      Decimal @db.Decimal(12, 2)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@map("quotation_items")
}

// ─── Sales Orders ───────────────────────────────────────────────

model SalesOrder {
  id          Int              @id @default(autoincrement())
  orderNumber String           @unique
  customerId  Int
  quotationId Int              @unique  // Prevents duplicate SO from same quotation
  orderDate   DateTime         @default(now())
  totalAmount Decimal          @db.Decimal(12, 2)
  status      SalesOrderStatus @default(PENDING)
  createdById Int
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  customer  Customer         @relation(fields: [customerId], references: [id])
  quotation Quotation        @relation(fields: [quotationId], references: [id])
  createdBy User             @relation(fields: [createdById], references: [id])
  items     SalesOrderItem[]
  dispatch  Dispatch?

  @@map("sales_orders")
}

model SalesOrderItem {
  id           Int     @id @default(autoincrement())
  salesOrderId Int
  productId    Int
  quantity     Int
  unitPrice    Decimal @db.Decimal(12, 2)
  lineAmount   Decimal @db.Decimal(12, 2)

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id])

  @@map("sales_order_items")
}

// ─── Dispatches ─────────────────────────────────────────────────

model Dispatch {
  id             Int      @id @default(autoincrement())
  dispatchNumber String   @unique
  salesOrderId   Int      @unique  // Prevents duplicate dispatch for same SO
  dispatchDate   DateTime @default(now())
  vehicleNumber  String
  driverName     String
  processedById  Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  salesOrder  SalesOrder    @relation(fields: [salesOrderId], references: [id])
  processedBy User          @relation(fields: [processedById], references: [id])
  items       DispatchItem[]

  @@map("dispatches")
}

model DispatchItem {
  id         Int @id @default(autoincrement())
  dispatchId Int
  productId  Int
  quantity   Int

  dispatch Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("dispatch_items")
}
